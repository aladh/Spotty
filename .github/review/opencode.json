{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/muse-spark-1.3-contributor-free",
  "small_model": "opencode/muse-spark-1.3-contributor-free",
  "share": "disabled",
  "autoupdate": false,
  "lsp": false,
  "formatter": false,
  "permission": {
    "*": "deny",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "bash": "allow",
    "websearch": "allow",
    "webfetch": "allow",
    "external_directory": "allow",
    "edit": "allow"
  },
  "agent": {
    "thermos": {
      "mode": "primary",
      "description": "Coordinate the two Thermos audits and publish one comment.",
      "prompt": "{file:thermos/orchestration.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "task": {
          "*": "deny",
          "thermos-correctness": "allow",
          "thermos-quality": "allow"
        },
        "websearch": "allow",
        "webfetch": "allow",
        "external_directory": "allow",
        "edit": "allow"
      }
    },
    "thermos-correctness": {
      "mode": "subagent",
      "description": "Independent Thermos correctness audit.",
      "prompt": "{file:thermos/correctness.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "websearch": "allow",
        "webfetch": "allow",
        "external_directory": "allow",
        "edit": "allow"
      }
    },
    "thermos-quality": {
      "mode": "subagent",
      "description": "Independent Thermos quality audit.",
      "prompt": "{file:thermos/quality.md}",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "websearch": "allow",
        "webfetch": "allow",
        "external_directory": "allow",
        "edit": "allow"
      }
    }
  }
}
