      ],
      "actions": [
        "Deliver stale observations in the acceptance-only ordering variation"
      ],
      "assertions": [
        "The newer current position survives older partial playback observations"
      ],
      "safety": {
        "dependencies": "synthetic",
        "liveMutations": false,
        "audioOutput": false
      },
      "timeoutSeconds": 120,
      "terminalCondition": "All declared state checkpoints pass",
