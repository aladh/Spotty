        "checkpoints",
        "timeline",
        "isolation"
      ]
    },
    {
      "id": "playback.recovery",
      "version": 1,
      "corpus": "representative",
      "workload": "Tests/BrowsingHarness/playback.json",
      "contracts": [
        "docs/product/playback-evidence.md"
      ],
      "actions": [
        "Select, pause, and resume synthetic playback",
        "Reject seek and selection",
        "Inject stale handoff, disconnect, refused resume, and account replacement",
        "Hydrate queue metadata"
      ],
      "assertions": [
        "Only matching observations confirm commands",
        "Rejected commands settle without false playback truth",
        "Dismissed recovery notices retain the semantic resume block",
        "Old owners cannot publish after replacement"
      ],
      "safety": {
        "dependencies": "synthetic",
        "liveMutations": false,
        "audioOutput": false
      },
      "timeoutSeconds": 120,
      "terminalCondition": "All declared state checkpoints pass",
      "evidence": [
        "checkpoints",
        "timeline",
        "isolation"
      ]
    },
    {
