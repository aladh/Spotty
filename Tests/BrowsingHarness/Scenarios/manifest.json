{
  "schemaVersion": 1,
  "scenarios": [
    {
      "id": "shell.signed-out",
      "version": 1,
      "corpus": "representative",
      "workload": "Tests/BrowsingHarness/Scenarios/signed-out.json",
      "contracts": [
        "docs/product/safe-testing.md#spotty-demo-standing-authorization"
      ],
      "actions": [
        "Restore the synthetic signed-out account"
      ],
      "assertions": [
        "The account remains signed out",
        "No engine initialization or forbidden mutation occurs"
      ],
      "safety": {
        "dependencies": "synthetic",
        "liveMutations": false,
        "audioOutput": false
      },
      "timeoutSeconds": 60,
      "terminalCondition": "All declared state checkpoints pass",
      "evidence": [
        "checkpoints",
        "timeline",
        "isolation"
      ]
    },
    {
      "id": "browsing.navigation",
      "version": 1,
      "corpus": "representative",
      "workload": "Tests/BrowsingHarness/scenario.json",
      "contracts": [
        "docs/product/scope.md#visual-fidelity-and-interaction"
      ],
      "actions": [
        "Restore the synthetic account",
        "Load and revisit both fixture playlists",
        "Return to Home"
      ],
      "assertions": [
        "The catalog contains the declared track count",
        "Revisits retain the correct playlist",
        "No forbidden mutation occurs"
      ],
      "safety": {
        "dependencies": "synthetic",
        "liveMutations": false,
        "audioOutput": false
      },
      "timeoutSeconds": 120,
      "terminalCondition": "All declared state checkpoints pass",
