{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "rebaseWhen": "conflicted",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the pinned cbindgen tool and its synchronized references",
      "managerFilePatterns": [
        "/^\\.github/workflows/(?:ci|playback-artifact)\\.yml$/",
        "/^Backend/spotty-playback/cbindgen\\.toml$/",
        "/^Scripts/generate-c-header\\.sh$/",
        "/^docs/development/setup\\.md$/"
      ],
      "matchStrings": [
        "cargo install cbindgen --locked --version (?<currentValue>\\d+\\.\\d+\\.\\d+)(?:[\\s`.]|$)",
        "required_cbindgen_version=\\\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\\\"",
        "autogen_warning = \\\"[^\\r\\n]*cbindgen (?<currentValue>\\d+\\.\\d+\\.\\d+)\\. Do not edit\\. \\*/\\\"",
        "Install cbindgen (?<currentValue>\\d+\\.\\d+\\.\\d+) for header"
      ],
      "depNameTemplate": "cbindgen",
      "datasourceTemplate": "crate"
    }
  ],
  "packageRules": [
    {
      "description": "Group playback engine dependency updates for one artifact publication",
      "matchManagers": ["cargo"],
      "groupName": "Playback engine dependencies",
      "groupSlug": "playback-engine-dependencies",
      "separateMajorMinor": false
    },
    {
      "description": "Delay crates.io updates without delaying librespot git revisions",
      "matchManagers": ["cargo"],
      "matchDatasources": ["crate"],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Group non-major GitHub Actions updates and retain digest pins",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions"
    },
    {
      "description": "Group the Rust toolchain with playback engine dependencies",
      "matchManagers": ["rust-toolchain"],
      "minimumReleaseAge": "3 days",
      "groupName": "Playback engine dependencies",
      "groupSlug": "playback-engine-dependencies",
      "separateMajorMinor": false
    },
    {
      "description": "Group synchronized cbindgen updates with playback engine dependencies",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["cbindgen"],
      "minimumReleaseAge": "3 days",
      "groupName": "Playback engine dependencies",
      "groupSlug": "playback-engine-dependencies",
      "separateMajorMinor": false
    }
  ]
}
