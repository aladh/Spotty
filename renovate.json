{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "rebaseWhen": "conflicted",
  "packageRules": [
    {
      "description": "Review Rust application and playback dependency updates together",
      "matchManagers": ["cargo"],
      "groupName": "Playback engine dependencies",
      "groupSlug": "playback-engine-dependencies",
      "separateMajorMinor": false
    },
    {
      "description": "Delay crates.io updates without delaying librespot git revisions",
      "matchManagers": ["cargo"],
      "matchDatasources": ["crate"],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Group non-major GitHub Actions updates and retain digest pins",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions"
    },
    {
      "description": "Group the Rust toolchain with playback engine dependencies",
      "matchManagers": ["rust-toolchain"],
      "minimumReleaseAge": "3 days",
      "groupName": "Playback engine dependencies",
      "groupSlug": "playback-engine-dependencies",
      "separateMajorMinor": false
    }
  ]
}
